<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="480.0" prefWidth="450.0" spacing="14.0" style="-fx-background-color: #ffffff;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <!-- Cabecera -->
      <VBox spacing="4.0">
         <children>
            <Label fx:id="lblTituloFicha" text="Ficha de Lote">
               <font>
                  <Font name="System Bold" size="20.0" />
               </font>
            </Label>
            <Label fx:id="lblSubtituloLote" text="Recibe: Lote Cantero A" textFill="#6c757d">
               <font>
                  <Font size="13.0" />
               </font>
            </Label>
         </children>
      </VBox>
      
      <!-- Estado del lote -->
      <VBox spacing="6.0">
         <children>
            <Label text="Estado:" textFill="#333333">
               <font>
                  <Font name="System Bold" size="13.0" />
               </font>
            </Label>
            <ComboBox fx:id="cmbEstado" maxWidth="1.7976931348623157E308" prefHeight="35.0" promptText="EN_COSECHA" />
         </children>
      </VBox>
      
      <!-- Historial de Cosechas -->
      <VBox spacing="6.0" VBox.vgrow="ALWAYS">
         <children>
            <Label text="Historial de cosechas (lista enlazada)" textFill="#333333">
               <font>
                  <Font name="System Bold" size="13.0" />
               </font>
            </Label>
            <TableView fx:id="tblHistorialCosechas" prefHeight="180.0" VBox.vgrow="ALWAYS">
              <columns>
                <TableColumn fx:id="colFecha" prefWidth="180.0" text="Fecha" />
                <TableColumn fx:id="colKg" prefWidth="210.0" text="Kg" />
              </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </children>
      </VBox>
      
      <!-- Botones de Acción -->
      <HBox alignment="CENTER_LEFT" spacing="10.0">
         <children>
            <Button fx:id="btnDeshacer" mnemonicParsing="false" prefHeight="35.0" prefWidth="120.0" style="-fx-background-color: #d97706; -fx-text-fill: white; -fx-font-weight: bold;" text="Deshacer" />
            <Pane HBox.hgrow="ALWAYS" />
            <Button fx:id="btnCerrar" mnemonicParsing="false" prefHeight="35.0" prefWidth="100.0" text="Cerrar" />
         </children>
         <VBox.margin>
            <Insets top="10.0" />
         </VBox.margin>
      </HBox>
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
