<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="480.0" prefWidth="440.0" spacing="16.0" style="-fx-background-color: #ffffff;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <!-- Cabecera -->
      <VBox spacing="4.0">
         <children>
            <Label fx:id="lblTituloFormulario" text="Alta de Productor" textFill="#2e7d32">
               <font>
                  <Font name="System Bold" size="20.0" />
               </font>
            </Label>
            <Label text="Ingresa los datos del productor (Acción exclusiva de Administrador)" textFill="#6c757d">
               <font>
                  <Font size="12.0" />
               </font>
            </Label>
         </children>
      </VBox>
      
      <!-- Campo Nombre -->
      <VBox spacing="6.0">
         <children>
            <Label text="Nombre y Apellido / Razón Social: *" textFill="#333333">
               <font>
                  <Font name="System Bold" size="13.0" />
               </font>
            </Label>
            <TextField fx:id="txtNombre" prefHeight="38.0" promptText="Ej: Huerta El Trébol / Juan Pérez" style="-fx-background-radius: 6; -fx-border-color: #ced4da; -fx-border-radius: 6;" />
         </children>
      </VBox>
      
      <!-- Campo DNI o CUIT -->
      <VBox spacing="6.0">
         <children>
            <Label text="DNI o CUIT: *" textFill="#333333">
               <font>
                  <Font name="System Bold" size="13.0" />
               </font>
            </Label>
            <TextField fx:id="txtDniCuit" prefHeight="38.0" promptText="Ej: 20-34567890-9 o 34567890" style="-fx-background-radius: 6; -fx-border-color: #ced4da; -fx-border-radius: 6;" />
         </children>
      </VBox>
      
      <!-- Campo Localidad -->
      <VBox spacing="6.0">
         <children>
            <Label text="Localidad: *" textFill="#333333">
               <font>
                  <Font name="System Bold" size="13.0" />
               </font>
            </Label>
            <TextField fx:id="txtLocalidad" prefHeight="38.0" promptText="Ej: La Plata, Buenos Aires" style="-fx-background-radius: 6; -fx-border-color: #ced4da; -fx-border-radius: 6;" />
         </children>
      </VBox>
      
      <!-- Campo Estado -->
      <VBox spacing="6.0">
         <children>
            <Label text="Estado: *" textFill="#333333">
               <font>
                  <Font name="System Bold" size="13.0" />
               </font>
            </Label>
            <ComboBox fx:id="cmbEstado" maxWidth="1.7976931348623157E308" prefHeight="38.0" promptText="Seleccione estado..." style="-fx-background-radius: 6;" />
         </children>
      </VBox>
      
      <!-- Mensaje de Error / Feedback -->
      <Label fx:id="lblError" text="" textFill="#d32f2f" wrapText="true">
         <font>
            <Font size="12.0" />
         </font>
      </Label>
      
      <!-- Botones de Acción -->
      <HBox alignment="CENTER_RIGHT" spacing="12.0">
         <children>
            <Button fx:id="btnCancelar" mnemonicParsing="false" prefHeight="38.0" prefWidth="100.0" style="-fx-background-radius: 6; -fx-cursor: hand;" text="Cancelar" />
            <Button fx:id="btnGuardar" mnemonicParsing="false" prefHeight="38.0" prefWidth="130.0" style="-fx-background-color: #2e7d32; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" text="Guardar" />
         </children>
         <VBox.margin>
            <Insets top="8.0" />
         </VBox.margin>
      </HBox>
   </children>
   <padding>
      <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
   </padding>
</VBox>
